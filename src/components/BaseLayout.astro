---
import "../styles/global.css";
import { Font } from "astro:assets";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { SITE_TITLE } from "../consts";

import FallbackOgImage from "../assets/default-social-card.png";

// define the props that can be passed to this layout component
interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

// extract the props passed from the page, or fall back to the constants
const { title, description, image = FallbackOgImage } = Astro.props;

// Constructs the exact, full URL of the current page
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <!-- global metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("dev-indepth-theme");
        const preferredTheme = window.matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";

        document.documentElement.dataset.theme =
          savedTheme === "light" || savedTheme === "dark" ? savedTheme : preferredTheme;
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- points search engines directly to your generated sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL("rss.xml", Astro.site)}
    />

    <!-- canonical url -->
    <!-- tells google "this is the official url for this page". -->
    <link rel="canonical" href={canonicalURL} />

    <!-- primary meta tags (google search) -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- open graph metadata (linkedin & social sharing) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image.src, Astro.url)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- adding suse-mono font using font provider -->
    <Font cssVariable="--font-suse-mono" />
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
