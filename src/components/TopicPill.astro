---
import { slugify } from "../lib/topics";

import { BASE_PATH } from "../consts";
interface Props {
  topic: string;
  count: number;
}

const { topic, count } = Astro.props;
const topicUrl = `${BASE_PATH}/topics/${slugify(topic)}`;
---

<a class="topic" href={topicUrl}>
  #{topic}
  <span class="topic-count">{count}</span>
</a>

<style>
  .topic {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    border: 1px solid var(--color-text);
    border-radius: 4px;
    padding: 0.2rem 0.4rem;
    text-decoration: none;
    transition: opacity 180ms ease;

    &:hover {
      opacity: 0.6;
    }
  }

  .topic-count {
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding-inline: 0.2rem;
    border-radius: 50%;
    background: var(--color-bg-alt);
    color: var(--color-text-alt);
    font-size: 0.65rem;
  }
</style>
