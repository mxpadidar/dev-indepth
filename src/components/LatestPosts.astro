---
import { Icon } from "astro-icon/components";
import PostCard from "./PostCard.astro";
import { getPosts } from "../lib/posts";

interface Props {
  limit?: number;
}

const { limit = 3 } = Astro.props;
const posts = await getPosts(limit);
---

<section class="section-heading">
  <h2>Latest posts</h2>
  <div class="view-all-link">
    <a href="/posts">view all</a>
    <span>&rarr;</span>
  </div>
</section>

<div class="posts-grid">
  <button
    class="home-search"
    type="button"
    data-search-trigger
    aria-haspopup="dialog"
    aria-controls="post-search-dialog"
  >
    <Icon name="mdi:search" size={18} aria-hidden="true" />
    <span>search posts</span>
    <kbd>ctrl + k</kbd>
  </button>

  {posts.map((post) => <PostCard post={post} />)}
</div>

<style>
  .home-search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-bg-alt);
    border-radius: 4px;
    background: var(--color-bg-alt);
    color: var(--color-text-alt);
    font: inherit;
    cursor: pointer;
    transition: border-color 180ms ease;

    &:hover {
      border-color: var(--color-text-alt);
    }
  }

  .home-search kbd {
    margin-left: auto;
    font: inherit;
    font-size: 0.7rem;
  }

  .view-all-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;

    h2 {
      margin-top: 0;
    }

    a {
      font-size: 0.85rem;
    }
  }

  .posts-grid {
    display: grid;
    gap: 1rem;
  }
</style>
