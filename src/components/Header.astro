---
import Brand from "./Brand.astro";
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isPosts = pathname.startsWith("/posts");
const isTopics = pathname.startsWith("/topics");
const isAbout = pathname.startsWith("/about");
---

<header>
  <nav class="container" aria-label="Main navigation">
    <div class="nav-row">
      <div class="nav-primary">
        <Brand />
        <div class="desktop-nav">
          <a href="/posts" aria-current={isPosts ? "page" : undefined}>Posts</a>
          <a href="/topics" aria-current={isTopics ? "page" : undefined}>Topics</a>
          <a href="/about" aria-current={isAbout ? "page" : undefined}>About</a>
        </div>
      </div>

      <div class="nav-actions">
        <Search />
        <ThemeToggle />
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open navigation menu"
          aria-controls="mobile-navigation"
          aria-expanded="false"
          data-menu-toggle
        >
          <svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="close-icon" aria-hidden="true" viewBox="0 0 24 24">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="mobile-nav" id="mobile-navigation" data-mobile-nav hidden>
      <a href="/" aria-current={isHome ? "page" : undefined}>Home</a>
      <a href="/posts" aria-current={isPosts ? "page" : undefined}>Posts</a>
      <a href="/topics" aria-current={isTopics ? "page" : undefined}>Topics</a>
      <a href="/about" aria-current={isAbout ? "page" : undefined}>About</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-nav]");

  toggle?.addEventListener("click", () => {
    if (!menu) return;
    const expanded = toggle.getAttribute("aria-expanded") !== "true";

    toggle.setAttribute("aria-expanded", String(expanded));
    toggle.setAttribute("aria-label", `${expanded ? "Close" : "Open"} navigation menu`);
    menu.hidden = !expanded;
  });
</script>

<style>
  header {
    border-bottom: 1px solid var(--color-bg-alt);
    text-transform: uppercase;
  }

  nav {
    padding-block: 1rem;
  }

  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-primary,
  .desktop-nav,
  .nav-actions {
    display: flex;
    align-items: center;
  }

  .nav-primary {
    gap: 1.5rem;
  }

  .desktop-nav {
    gap: 1.25rem;
  }

  .nav-actions {
    gap: 0.25rem;
  }

  a {
    font-weight: 400;
    text-decoration: none;
    transition:
      font-weight 180ms ease,
      opacity 180ms ease;
  }

  a:hover {
    opacity: 0.6;
    font-weight: 700;
  }

  a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 700;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-bg-alt);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .menu-toggle:hover,
  .menu-toggle:focus-visible {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--color-text-alt);
    outline-offset: 2px;
  }

  .menu-toggle svg {
    width: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .close-icon,
  .mobile-nav {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .menu-icon {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .close-icon {
    display: block;
  }

  @media (max-width: 640px) {
    .desktop-nav {
      display: none;
    }

    .nav-primary {
      gap: 0;
    }

    .menu-toggle {
      display: grid;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-bg-alt);
    }

    .mobile-nav a {
      padding-block: 0.35rem;
    }
  }
</style>
