---
import { Icon } from "astro-icon/components";
---

<footer>
  <div class="container footer-contact">
    <span class="get-in-touch">get in touch</span>
    <a class="mail-link" href="mailto:mxpadidar@gmail.com">
      <Icon name="mdi:email-outline" size={20} />
      <span>mxpadidar@gmail.com</span>
    </a>
  </div>

  <div class="footer-meta">
    <div>
      <span>&copy;</span>2026 dev-indepth. all rights reserved.
    </div>
    <div class="icons">
      <a href="https://github.com/mxpadidar" target="_blank" rel="noopener" title="GitHub">
        <Icon name="mdi:github" size={18} />
        <span class="sr-only">github</span>
      </a>

      <a href="https://linkedin.com/in/mxpadidar/" target="_blank" rel="noopener" title="LinkedIn">
        <Icon name="mdi:linkedin" size={18} />
        <span class="sr-only">linkedin</span>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-subtle);
    background: var(--color-bg-alt);
  }

  .footer-contact {
    padding-block: 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 1px solid var(--color-subtle);

    .get-in-touch {
      font-size: 1.25rem;
      font-weight: bolder;
      text-transform: uppercase;
    }

    .mail-link {
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  .footer-meta {
    max-width: 640px;
    margin-inline: auto;
    padding: 1rem 1.5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
  }

  .icons {
    display: flex;
    gap: 1rem;

    & a {
      display: flex;

      &:hover {
        color: var(--color-text-alt);
      }
    }
  }
</style>
