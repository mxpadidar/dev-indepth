---
import { Icon } from "astro-icon/components";
---

<footer>
  <div class="container footer-top">
    <a href="mailto:mxpadidar@gmail.com" title="email">
      <Icon name="mdi:email-outline" size={24} />
      <span class="sr-only">email</span>
    </a>

    <a href="https://github.com/mxpadidar" target="_blank" rel="noopener" title="GitHub">
      <Icon name="mdi:github" size={24} />
      <span class="sr-only">github</span>
    </a>

    <a href="https://linkedin.com/in/mxpadidar/" target="_blank" rel="noopener" title="LinkedIn">
      <Icon name="mdi:linkedin" size={24} />
      <span class="sr-only">linkedin</span>
    </a>
  </div>

  <div class="container footer-bottom">&copy; 2026 dev-indepth. all rights reserved.</div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-bg-alt);
    background: var(--color-bg);
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-block: 1.5rem 1rem;

    a {
      display: grid;
      place-items: center;
      width: 3rem;
      height: 3rem;
      border: 1px solid var(--color-bg-alt);
      border-radius: 50%;
      transition:
        color 180ms ease,
        border-color 180ms ease;

      &:hover {
        color: var(--color-brand);
        border-color: var(--color-brand);
      }
    }
  }

  .footer-bottom {
    padding-bottom: 2rem;
    color: var(--color-text-alt);
    font-size: 0.85rem;
    text-align: center;
  }
</style>
