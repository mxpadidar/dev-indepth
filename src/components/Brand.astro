---
interface Props {
  href?: string;
}

const { href = "/" } = Astro.props;
---

<a href={href} class="nav-brand" aria-label="dev-indepth">
  <div class="brand-row brand-top" aria-hidden="true">
    <span>D</span>
    <span>E</span>
    <span>V</span>
  </div>
  <div class="brand-row brand-bottom" aria-hidden="true">
    <span>I</span>
    <span>N</span>
    <span>D</span>
    <span>E</span>
    <span>P</span>
    <span>T</span>
    <span>H</span>
  </div>
</a>

<style>
  .nav-brand {
    display: grid;
    align-items: start;
    width: 4rem;
    text-decoration: none;
    color: var(--color-brand);
  }

  .brand-row {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-weight: 900;
  }

  .brand-row span {
    display: inline-block;
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .brand-top {
    font-size: 1.5rem;
    padding-inline: 0.4rem;
    margin-bottom: -0.2rem;
  }

  .brand-top span:nth-child(2) {
    transform: rotate(-20deg);
  }

  .brand-bottom {
    font-size: 0.75rem;
  }

  /* hover: DEV letters lift, and the tilted E snaps upright */
  .nav-brand:hover .brand-top span:nth-child(1) {
    transform: translateY(-2px);
  }

  .nav-brand:hover .brand-top span:nth-child(2) {
    transform: rotate(0deg) translateY(-4px);
  }

  .nav-brand:hover .brand-top span:nth-child(3) {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-row span {
      transition: none;
    }
  }
</style>
