---
import BaseLayout from "../components/BaseLayout.astro";

import { BASE_PATH } from "../consts";
const homeUrl = `${BASE_PATH}/`;
const DESCRIPTION =
  "A little bit about the backend engineer behind dev-indepth, focusing on Go, Python, and system architecture.";
---

<BaseLayout title="About" description={DESCRIPTION}>
  <h1>ABOUT ME...</h1>

  <p>
    I'm a backend software engineer who loves building scalable systems and untangling complex
    architectural puzzles. My daily work revolves mostly around Python and Go. I created dev-indepth
    as a personal knowledge base to document my technical journey, share practical deep dives, and
    connect with other developers navigating the backend ecosystem.
  </p>

  <div class="back-home">
    <span>&larr;</span>
    <a href={homeUrl}>back to home</a>
  </div>
</BaseLayout>

<style>
  .back-home {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
