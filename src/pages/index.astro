---
import BaseLayout from "../components/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import TopTopics from "../components/TopTopics.astro";
import { getPosts } from "../lib/posts";
import { SITE_TITLE, BASE_PATH } from "../consts";

const rssUrl = `${BASE_PATH}/rss.xml`;
const DESCRIPTION =
  "A digital notebook documenting real-world backend development, system design, Python, and Go.";

const posts = await getPosts();
---

<BaseLayout title={SITE_TITLE} description={DESCRIPTION}>
  <section class="hero">
    <h1>DEV INDEPTH</h1>
    <p class="tagline">backend · system design · python · go</p>
  </section>

  <p>
    Welcome to **dev-indepth** — a place to understand the ideas behind better backend software.
    Here I write practical deep dives into Python, Go, system design, software architecture, and the
    engineering decisions that shape real applications. The focus is on making complex ideas easier
    to understand through simple explanations, concrete examples, and problems that actually show up
    as codebases grow. No theory for the sake of theory — just useful concepts, trade-offs, and
    lessons that help you write software that is easier to understand, test, change, and maintain.
  </p>

  <p class="stats">
    {posts.length} posts · <a href={rssUrl}>rss feed</a>
  </p>

  <LatestPosts />

  <TopTopics />
</BaseLayout>

<style>
  .tagline {
    color: var(--color-text-alt);
    margin-block: 0 1rem;
  }

  .stats {
    color: var(--color-text-alt);
    font-size: 0.85rem;
    margin-block: 0.5rem 0;
  }
</style>
