---
import BaseLayout from "../components/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import TopTopics from "../components/TopTopics.astro";
import { getPosts } from "../lib/posts";
import { SITE_TITLE } from "../consts";

const DESCRIPTION =
  "A digital notebook documenting real-world backend development, system design, Python, and Go.";

const posts = await getPosts();
---

<BaseLayout title={SITE_TITLE} description={DESCRIPTION}>
  <section class="hero">
    <h1>DEV INDEPTH</h1>
    <p class="tagline">backend · system design · python · go</p>
  </section>

  <p>
    Welcome to dev-indepth, a digital notebook documenting the daily realities of backend
    development. Practical experiences with Python and Go, system design challenges, and lessons
    learned from active development.
  </p>

  <p class="stats">
    {posts.length} posts · <a href="/rss.xml">rss feed</a>
  </p>

  <LatestPosts />

  <TopTopics />
</BaseLayout>

<style>
  .tagline {
    color: var(--color-text-alt);
    margin-block: 0 1rem;
  }

  .stats {
    color: var(--color-text-alt);
    font-size: 0.85rem;
    margin-block: 0.5rem 0;
  }
</style>
