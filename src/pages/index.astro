---
import BaseLayout from "../components/BaseLayout.astro";
import LatestPosts from "../components/LatestPosts.astro";
import { SITE_TITLE } from "../consts";

const DESCRIPTION =
  "A digital notebook documenting real-world backend development, system design, Python, and Go.";

---

<BaseLayout title={SITE_TITLE} description={DESCRIPTION}>
  <h1>DEV INDEPTH</h1>

  <p>
    Welcome to dev-indepth, a digital notebook documenting the daily realities of backend
    development. The content here focuses on practical experiences with Python and Go, breaking down
    system design challenges, and exploring both foundational and modern software engineering
    concepts.
  </p>

  <p>
    This space is dedicated to technical details and lessons learned from active development—from
    scaling services and debugging complex concurrency issues to architecting new systems.
  </p>

  <div class="read-more">
    <a href="/about">read more about me</a>
    <span>&rarr;</span>
  </div>

  <LatestPosts />
</BaseLayout>

<style>
  .read-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

</style>
