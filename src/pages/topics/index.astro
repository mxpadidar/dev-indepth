---
import BaseLayout from "../../components/BaseLayout.astro";
import Topics from "../../components/Topics.astro";
import { getTopics } from "../../lib/topics";

const DESCRIPTION =
  "All topics covered on dev-indepth, each with the number of posts written about it.";

const topics = await getTopics();
---

<BaseLayout title="Topics" description={DESCRIPTION}>
  <h1>Topics</h1>
  <div class="topic-list">
    <Topics topics={topics} />
  </div>
</BaseLayout>

<style>
  .topic-list {
    margin-top: 1rem;
  }
</style>
