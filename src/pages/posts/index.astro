---
import BaseLayout from "../../components/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getPostPages } from "../../lib/posts";

const pages = await getPostPages();
const posts = pages[0] ?? [];

const DESCRIPTION =
  "A collection of technical blog posts covering backend development, system architecture, and programming languages like Go and Python.";
---

<BaseLayout title="Blog Posts" description={DESCRIPTION}>
  <h1>Blog Posts</h1>
  <div class="posts-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <Pagination currentPage={1} totalPages={pages.length} />
</BaseLayout>

<style>
  .posts-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
