---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../components/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import PostTags from "../../components/PostTags.astro";
import { getPosts } from "../../lib/posts";

import { BASE_PATH } from "../../consts";
const postsUrl = `${BASE_PATH}/posts`;
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<"blogPosts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.heroImage}>
  <article>
    <a class="back-link" href={postsUrl}>&larr; all posts</a>
    <h2>{post.data.title}</h2>
    <div class="post-meta">
      <PostTags tags={post.data.tags} />
      <div class="meta-right">
        <span class="published-at"><FormattedDate date={post.data.publishedAt} /></span>
      </div>
    </div>
    {
      post.data.heroImage && (
        <Image
          class="hero"
          src={post.data.heroImage}
          alt={post.data.title}
          width={640}
          height={360}
        />
      )
    }

    <div class="content"><Content /></div>
  </article>
</BaseLayout>

<style>
  .back-link {
    font-size: 0.85em;
  }

  .published-at {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-text-alt);
    font-size: 0.85rem;
  }

  .post-meta {
    display: grid;
    gap: 0.75rem;
  }

  .meta-right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--color-bg-alt);
    margin-block: 1rem 1.5rem;
  }
</style>
