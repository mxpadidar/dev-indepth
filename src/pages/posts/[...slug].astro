---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../components/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import TagList from "../../components/TagList.astro";
import { getPosts } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<"blogPosts">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} image={post.data.heroImage}>
  <article>
    <a class="back-link" href="/posts">&larr; all posts</a>
    <h2>{post.data.title}</h2>
    <div>
      <TagList tags={post.data.tags} />
      <span class="published-at"><FormattedDate date={post.data.publishedAt} /></span>
    </div>
    {
      post.data.heroImage && (
        <Image
          class="hero"
          src={post.data.heroImage}
          alt={post.data.title}
          width={640}
          height={360}
        />
      )
    }

    <div class="content"><Content /></div>
  </article>
</BaseLayout>

<style>
  .back-link {
    font-size: 0.85em;
  }

  .published-at {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-text-alt);
    font-size: 0.85rem;
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--color-bg-alt);
    margin-block: 1rem 1.5rem;
  }
</style>
